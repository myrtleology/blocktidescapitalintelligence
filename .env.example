# Avalanche Fuji via QuickNode
FUJI_RPC_URL=https://your-quicknode-fuji-endpoint

# MetaMask deployment wallet private key (without 0x)
DEPLOYER_PRIVATE_KEY=your_private_key

# Snowtrace API key (optional, only for verification)
SNOWTRACE_API_KEY=your_snowtrace_api_key

# Optional dedicated oracle address; defaults to deployer
ORACLE_ADDRESS=0xYourOracleAddress
ADMIN_ADDRESS=0xYourAdminAddress

# Set after deploy
BTCI_REGISTRY_ADDRESS=0xYourDeployedRegistry

# Subject wallet used for update/query tests
SUBJECT_ADDRESS=0xTargetWallet
NEW_SCORE=750

# Fuji USDC test token and flow amount for simulation
USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
USDC_FLOW_AMOUNT=5

# QuickNode WebSocket for event relay
FUJI_WS_URL=wss://your-quicknode-fuji-ws-endpoint

# Optional addresses used by event relay
GOVERNANCE_ADDRESS=0xYourGovernanceAddress
STAKING_ADDRESS=0xYourStakingAddress
EVENT_SERVER_PORT=8787
